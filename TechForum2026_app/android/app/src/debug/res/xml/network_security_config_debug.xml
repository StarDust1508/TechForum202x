<?xml version="1.0" encoding="utf-8"?>
<!--
  CRITICAL: этот файл переопределяет network_security_config.xml при
  ./gradlew assembleDebug. По умолчанию Capacitor 8 генерирует здесь
  domain-config только для localhost/10.0.2.2/devServer-host — без
  72.56.9.90 OkHttp падал с "Cleartext HTTP traffic not permitted".
  Зеркалим main NSC: глобальный base-config с cleartextTrafficPermitted=true.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
