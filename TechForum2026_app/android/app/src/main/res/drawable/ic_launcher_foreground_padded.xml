<?xml version="1.0" encoding="utf-8"?>
<!--
    BUG_FIX_CONTEXT: Adaptive-icon foreground PNG в mipmap-* содержит "TF"
    монограмму, заполняющую почти всю площадь 108dp холста. На launcher-экране
    (особенно при круглой/squircle маске) лого выходило за safe-zone и
    обрезалось — выглядело "перетянутым". Inset 22dp = ~20% даёт лого больше
    воздуха, хорошо читается под любой маской (круг, squircle, тяг, капля).
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@mipmap/ic_launcher_foreground"
    android:insetLeft="22dp"
    android:insetTop="22dp"
    android:insetRight="22dp"
    android:insetBottom="22dp" />
