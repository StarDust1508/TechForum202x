<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- BUG_FIX_CONTEXT: parent был Theme.AppCompat.Light.DarkActionBar — у Light-темы
         android:windowBackground = белый. На S25 / iPhone 17 при холодном старте,
         keyboard show, orientation change мерцала белая полоса. Переключаем на
         NoActionBar (без светлого windowBackground) и явно задаём тёмный фон,
         status bar и navigation bar — единый brand_dark. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/brand_dark</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Launch theme. БЫЛО: @drawable/splash → растровое лого «TechForum 2026»
         в 12 dpi-папках, юзер видел его при каждом cold-start. По требованию
         заказчика лого убрано — splash чисто тёмный brand_dark. React-слой
         подхватывает blueprint conference-bg.jpg через минимум 1с (см. App.tsx
         loading-экран) — это и есть «встреча blueprint»-ом. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme">
        <item name="android:windowBackground">@color/brand_dark</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
