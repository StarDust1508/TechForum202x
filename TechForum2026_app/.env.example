# Backend
PORT=3000
NODE_ENV=development
SESSION_SECRET=dev-session-secret-change-me
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost

# Postgres connection (Drizzle ORM)
# Local dev: postgres://<user>:<pass>@127.0.0.1:5432/techforum_dev
# Production VPS: postgres://techforum:<strong-pass>@127.0.0.1:5432/techforum
DATABASE_URL=postgres://techforum:devpass@127.0.0.1:5432/techforum_dev

# AI (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend runtime endpoint
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
VITE_WS_BASE_URL=ws://127.0.0.1:3000
VITE_ENABLE_LOCAL_FALLBACK=true
