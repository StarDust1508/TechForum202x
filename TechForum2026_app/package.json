{
  "name": "techforum2026",
  "private": true,
  "version": "1.8.7",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:android": "VITE_BUILD_SHORT_SHA=$(git rev-parse --short HEAD) vite build --mode android",
    "build:ios": "VITE_BUILD_SHORT_SHA=$(git rev-parse --short HEAD) vite build --mode ios",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "android:store": "npm run build:android && npx cap sync android && cd android && ./gradlew assembleRelease bundleRelease",
    "ios:sync": "npm run build:ios && CAP_APP_ID=ru.techpravo.conference npx cap sync ios"
  },
  "dependencies": {
